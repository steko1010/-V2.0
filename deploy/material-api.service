# =============================================================
# systemd 服务：物料认证管理系统后端（API 模式，供 Nginx 反代）
# -------------------------------------------------------------
# 安装方法（示例，Linux 服务器）：
#   1) 把项目放到 /opt/material-cert-manager
#   2) sudo cp deploy/material-api.service /etc/systemd/system/
#   3) 修改下面 WorkingDirectory / User / ExecStart 等为实际值
#   4) sudo systemctl daemon-reload
#   5) sudo systemctl enable --now material-api
#   6) 用 deploy/nginx-materials.conf 配置 Nginx 后：nginx -t && systemctl reload nginx
#
# Windows 部署时不需要本文件：安装 PM2 后
#   set SERVE_STATIC=0&& set HOST=127.0.0.1&& pm2 start server.js --name material-api
# =============================================================
[Unit]
Description=Material Cert Manager API (Node.js, Nginx reverse proxy)
After=network.target

[Service]
Type=simple
# 修改为实际部署路径
WorkingDirectory=/opt/material-cert-manager

# ---- 运行模式：前端由 Nginx 托管，本服务仅提供 /api 与 /uploads ----
Environment=NODE_ENV=production
Environment=SERVE_STATIC=0
# 仅监听本机回环，由 Nginx 统一对外（避免他人绕过 Nginx 直连 3000）
Environment=HOST=127.0.0.1
Environment=PORT=3000
# 生产会话密钥：务必改成自己的长随机串（否则所有部署共用同一密钥）
Environment=SESSION_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-SECRET-STRING

# Node 可执行文件路径（which node 查看）。服务器需 Node >= 22.5；
# 若用 22.5~23.3 的 node:sqlite 需加实验开关：/usr/bin/node --experimental-sqlite server.js
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

# 进程账号：建议单独创建非 root 账号，并把项目目录归属给它
User=materials
Group=materials
NoNewPrivileges=true
ProtectSystem=full
# 数据与上传目录允许写入
ReadWritePaths=/opt/material-cert-manager/data /opt/material-cert-manager/uploads

[Install]
WantedBy=multi-user.target
