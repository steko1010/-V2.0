# =============================================================
# 环境变量示例 —— 复制为「项目根目录 .env」后按需修改：
#   Linux:   cp deploy/.env.example .env
#   Windows: copy deploy\.env.example .env
# server.js 启动时会自动读取项目根目录下的 .env
# =============================================================

# 会话签名密钥：生产必须改成自己的长随机串
# 可用命令生成：openssl rand -hex 32
SESSION_SECRET=please-change-to-a-long-random-string

# 前后端分离部署：设 0 表示前端页面由 Nginx 托管，本服务只提供 /api 与 /uploads
# 单机模式（默认）可注释掉或设为 1，由本服务同时托管页面
SERVE_STATIC=0

# 仅监听本机回环地址，让 Nginx 反代对外；多人直连访问时改回 0.0.0.0 或删掉
HOST=127.0.0.1

# 后端服务端口（Nginx proxy_pass 需一致）
PORT=3000
